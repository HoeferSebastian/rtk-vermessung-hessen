<Window x:Class="Ntrip.Wpf.Offline.OfflineMapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Offline-Karte verwalten – ALKIS &amp; Luftbild (HVBG)" Width="660" Height="800" MinHeight="640"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="12.5" Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="GroupBox"><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Padding" Value="8,6"/></Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="12,5"/><Setter Property="Margin" Value="0,3,6,3"/></Style>
        <Style TargetType="TextBox"><Setter Property="Margin" Value="0,3"/><Setter Property="Padding" Value="3,2"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,3"/></Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#868E96"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,2,0,4"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                Laden Sie das Arbeitsgebiet <Run FontWeight="SemiBold">vorab</Run> herunter. Danach steht die Karte im Gelände ohne Internet zur Verfügung.
                Quelle: amtliche Geobasisdaten Hessen (Open Data, HVBG) – die Nutzung ist kostenfrei und ohne Einschränkung erlaubt.
            </TextBlock>

            <GroupBox Header="1  Gebiet">
                <StackPanel>
                    <RadioButton x:Name="AreaView" Content="Aktueller Kartenausschnitt" IsChecked="True" Margin="0,2" Checked="Input_Changed"/>
                    <RadioButton x:Name="AreaPoints" Content="Umgebung aller Grenzpunkte" Margin="0,2" Checked="Input_Changed"/>
                    <RadioButton x:Name="AreaTracks" Content="Entlang aller aufgezeichneten Spuren" Margin="0,2" Checked="Input_Changed"/>
                    <RadioButton x:Name="AreaPosition" Content="Umkreis um die aktuelle GNSS-Position" Margin="0,2" Checked="Input_Changed"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="Puffer / Radius [m]"/>
                        <TextBox x:Name="BufferBox" Width="70" Text="300" TextChanged="Input_Changed"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Text="(gilt für Punkte, Spuren und Position; beim Kartenausschnitt ohne Puffer)"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="2  Karteninhalt">
                <StackPanel>
                    <CheckBox x:Name="LayerAlk" Content="ALKIS-Liegenschaftskarte (Flurstücke, Gebäude, Grenzpunkte)" IsChecked="True" Margin="0,2" Checked="Input_Changed" Unchecked="Input_Changed"/>
                    <CheckBox x:Name="LayerDop" Content="Luftbild DOP20 (20 cm Auflösung)" IsChecked="True" Margin="0,2" Checked="Input_Changed" Unchecked="Input_Changed"/>
                    <CheckBox x:Name="LayerAlkT" Content="ALKIS-Grenzen transparent (nur nötig für die Ansicht „Luftbild + Grenzen“)" IsChecked="True" Margin="0,2" Checked="Input_Changed" Unchecked="Input_Changed"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="3  Detailstufen (Zoom)">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="von"/>
                        <ComboBox x:Name="ZoomMin" Width="60" SelectionChanged="Input_Changed"/>
                        <TextBlock VerticalAlignment="Center" Margin="12,0,8,0" Text="bis"/>
                        <ComboBox x:Name="ZoomMax" Width="60" SelectionChanged="Input_Changed"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Zoom 17 ≈ Straßenzug, 19 ≈ Grundstück (≈ 20 cm je Pixel, Auflösung des Luftbilds), 20 ≈ Detail für die Absteckung (höhere Stufen werden aus Stufe 20 vergrößert). Jede Stufe mehr vervierfacht die Datenmenge."/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="4  Umfang">
                <StackPanel>
                    <TextBlock x:Name="PlanText" Text="…" TextWrapping="Wrap" FontWeight="SemiBold"/>
                    <CheckBox x:Name="OverwriteBox" Content="Bereits vorhandene Kacheln aktualisieren (neu laden)" Margin="0,6,0,0"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="5  Herunterladen">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="StartButton" Content="⬇ Herunterladen starten" FontWeight="SemiBold" Click="Start_Click"/>
                        <Button x:Name="CancelButton" Content="Abbrechen" IsEnabled="False" Click="Cancel_Click"/>
                    </StackPanel>
                    <ProgressBar x:Name="Progress" Height="16" Margin="0,4" Minimum="0" Maximum="1"/>
                    <TextBlock x:Name="ProgressText" TextWrapping="Wrap" Text=""/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Gespeicherte Offline-Daten">
                <StackPanel>
                    <TextBlock x:Name="StoreText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                    <TextBlock x:Name="StorePathText" Style="{StaticResource Hint}"/>
                    <WrapPanel>
                        <Button Content="Ordner öffnen" Click="OpenFolder_Click"/>
                        <Button Content="Alle Offline-Daten löschen…" Click="ClearAll_Click"/>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Tipp: Die Datei lässt sich auf andere Rechner kopieren (Speicherort in appsettings.json → Map → TileStorePath)."/>
                </StackPanel>
            </GroupBox>

            <Button Content="Schließen" HorizontalAlignment="Right" Click="Close_Click" IsCancel="True"/>
        </StackPanel>
    </ScrollViewer>
</Window>
