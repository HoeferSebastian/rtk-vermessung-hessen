<Window x:Class="Ntrip.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="RTK Vermessung – Quectel LC29H + SAPOS NTRIP" Height="940" Width="1560" MinHeight="700" MinWidth="1180"
        Closing="Window_Closing" PreviewKeyDown="Window_KeyDown" Loaded="Window_Loaded"
        FontFamily="Segoe UI" FontSize="12.5">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#1C7ED6"/>
        <SolidColorBrush x:Key="Panel" Color="#F4F6F8"/>
        <SolidColorBrush x:Key="Line" Color="#D0D7DE"/>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,8,3"/>
            <Setter Property="Foreground" Value="#495057"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#868E96"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,6"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,3,6,3"/>
        </Style>
        <Style TargetType="ToggleButton">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,3,6,3"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E9ECEF"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        </Style>
        <Style x:Key="BigNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Menü -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Karte">
                <MenuItem Header="Offline-Karte verwalten / herunterladen…" Click="MenuOffline_Click"/>
                <MenuItem Header="Speicherort der Offline-Karte öffnen" Click="MenuOpenTileFolder_Click"/>
            </MenuItem>
            <MenuItem Header="_Projekt">
                <MenuItem Header="_Neu" Click="MenuNew_Click"/>
                <MenuItem Header="_Öffnen…" Click="MenuOpen_Click"/>
                <MenuItem Header="_Speichern" Click="MenuSave_Click"/>
                <MenuItem Header="Speichern _unter…" Click="MenuSaveAs_Click"/>
                <Separator/>
                <MenuItem Header="Importieren (GPX / CSV)…" Click="MenuImport_Click"/>
                <MenuItem Header="Export GPX (Punkte + Spuren)…" Click="MenuExportGpx_Click"/>
                <MenuItem Header="Export Grenzpunkte als CSV…" Click="MenuExportCsv_Click"/>
                <Separator/>
                <MenuItem Header="_Beenden" Click="MenuExit_Click"/>
            </MenuItem>
        </Menu>

        <!-- Statusleiste -->
        <Border DockPanel.Dock="Top" Background="#212529" Padding="10,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Ellipse x:Name="ReceiverDot" Width="11" Height="11" Fill="#868E96" Margin="0,0,5,0"/>
                    <TextBlock x:Name="ReceiverChip" Text="Empfänger" Foreground="White" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Ellipse x:Name="NtripDot" Width="11" Height="11" Fill="#868E96" Margin="0,0,5,0"/>
                    <TextBlock x:Name="NtripChip" Text="NTRIP" Foreground="White" VerticalAlignment="Center" Margin="0,0,18,0"/>
                    <Border x:Name="FixBorder" Background="#868E96" CornerRadius="3" Padding="10,2" Margin="0,0,18,0">
                        <TextBlock x:Name="FixText" Text="Kein Fix" Foreground="White" FontWeight="Bold" FontSize="14"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="StripSat" DockPanel.Dock="Right" Foreground="#CED4DA" VerticalAlignment="Center" FontFamily="Consolas"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StripPos" Foreground="White" FontFamily="Consolas" FontSize="14" VerticalAlignment="Center" Text="–" Margin="0,0,20,0"/>
                    <TextBlock x:Name="StripUtm" Foreground="#CED4DA" FontFamily="Consolas" FontSize="14" VerticalAlignment="Center" Text="" Margin="0,0,20,0"/>
                    <TextBlock x:Name="StripHeight" Foreground="#CED4DA" FontFamily="Consolas" FontSize="14" VerticalAlignment="Center" Text=""/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="230" MinHeight="90"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="300"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="470" MinWidth="380"/>
                </Grid.ColumnDefinitions>

                <!-- Karte -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1,1,1,0" Padding="8,3">
                        <WrapPanel>
                            <TextBlock Text="Karte" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="LayerBox" Width="215" SelectedIndex="0" SelectionChanged="LayerBox_SelectionChanged" Margin="0,3,12,3">
                                <ComboBoxItem Content="ALKIS Liegenschaftskarte (offline)" Tag="alk"/>
                                <ComboBoxItem Content="Luftbild DOP20 (offline)" Tag="dop"/>
                                <ComboBoxItem Content="Luftbild + Flurstücksgrenzen (offline)" Tag="dopalk"/>
                                <ComboBoxItem Content="Straßenkarte OSM (nur online)" Tag="osm"/>
                                <ComboBoxItem Content="Luftbild Esri (nur online)" Tag="sat"/>
                                <ComboBoxItem Content="Topographisch (nur online)" Tag="topo"/>
                            </ComboBox>
                            <ToggleButton x:Name="FollowToggle" Content="◎ Position folgen" IsChecked="True" Click="FollowToggle_Click"/>
                            <Button Content="⤢ Alles zeigen" Click="FitButton_Click"/>
                            <ToggleButton x:Name="DragToggle" Content="✥ Punkte verschieben" Click="DragToggle_Click"
                                          ToolTip="Wenn aktiv, lassen sich Grenzpunkte in der Karte mit der Maus ziehen."/>
                            <Rectangle Width="1" Fill="#CED4DA" Margin="4,4,10,4"/>
                            <Button Content="⬇ Offline-Karte…" Click="MenuOffline_Click" ToolTip="Arbeitsgebiet für den Einsatz ohne Internet herunterladen"/>
                            <ToggleButton x:Name="OnlineToggle" Content="⇅ Online nachladen" IsChecked="True" Click="OnlineToggle_Click"
                                          ToolTip="Ein: fehlende Kacheln werden bei Internetverbindung geladen und gespeichert. Aus: es werden nur gespeicherte Offline-Kacheln angezeigt."/>
                            <TextBlock x:Name="TileInfoText" Style="{StaticResource Label}" Foreground="#868E96" Margin="6,3,0,3"/>
                        </WrapPanel>
                    </Border>
                    <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <wv2:WebView2 x:Name="Web"/>
                    </Border>
                    <Border Grid.Row="2" x:Name="HintBar" Background="#FFF3BF" BorderBrush="#F08C00" BorderThickness="1" Padding="8,3" Visibility="Collapsed">
                        <TextBlock x:Name="HintText" Foreground="#5C3B00"/>
                    </Border>
                </Grid>

                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

                <!-- Rechte Seite: Aufgaben -->
                <TabControl x:Name="RightTabs" Grid.Column="2" SelectionChanged="RightTabs_SelectionChanged">

                    <!-- ============ Verbindung ============ -->
                    <TabItem Header="Verbindung">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                            <StackPanel>
                                <GroupBox Header="1  GNSS-Empfänger (seriell)">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource Label}" Text="COM-Port"/>
                                        <ComboBox x:Name="PortBox" Grid.Column="1" IsEditable="True"/>
                                        <Button Grid.Column="2" Content="⟳" Margin="4,3,0,3" Click="RefreshPorts_Click" ToolTip="Ports neu einlesen"/>
                                        <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Baudrate"/>
                                        <ComboBox x:Name="BaudBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" IsEditable="True" Text="460800">
                                            <ComboBoxItem Content="9600"/><ComboBoxItem Content="115200"/><ComboBoxItem Content="230400"/>
                                            <ComboBoxItem Content="460800"/><ComboBoxItem Content="921600"/>
                                        </ComboBox>
                                        <Button x:Name="ReceiverButton" Grid.Row="2" Grid.ColumnSpan="3" Content="Empfänger verbinden" Click="Receiver_Click" Margin="0,3,0,3"/>
                                    </Grid>
                                </GroupBox>

                                <GroupBox Header="2  NTRIP-Korrekturdaten (SAPOS)">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource Label}" Text="Host"/>
                                        <TextBox x:Name="HostBox" Grid.Column="1" Grid.ColumnSpan="2"/>
                                        <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Port"/>
                                        <TextBox x:Name="NtripPortBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"/>
                                        <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Mountpoint"/>
                                        <ComboBox x:Name="MountpointBox" Grid.Row="2" Grid.Column="1" IsEditable="True"/>
                                        <Button Grid.Row="2" Grid.Column="2" Content="Liste" Margin="4,3,0,3" Click="Sourcetable_Click" ToolTip="Mountpoints vom Caster laden"/>
                                        <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Benutzer"/>
                                        <TextBox x:Name="UserBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"/>
                                        <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Passwort"/>
                                        <PasswordBox x:Name="PasswordBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,3" Padding="3,2"/>
                                        <Button x:Name="NtripButton" Grid.Row="5" Grid.ColumnSpan="3" Content="NTRIP verbinden" Click="Ntrip_Click" Margin="0,3,0,3"/>
                                    </Grid>
                                </GroupBox>

                                <GroupBox Header="Status">
                                    <StackPanel>
                                        <TextBlock x:Name="ReceiverStatus" Text="Empfänger: nicht verbunden" TextWrapping="Wrap" Margin="0,2"/>
                                        <TextBlock x:Name="NtripStatus" Text="NTRIP: nicht verbunden" TextWrapping="Wrap" Margin="0,2"/>
                                        <TextBlock x:Name="DataStatus" TextWrapping="Wrap" Margin="0,2" Foreground="#868E96"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="Aktuelle Position (ETRS89)">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource Label}" Text="Breite"/>
                                        <TextBlock x:Name="LatText" Grid.Column="1" Style="{StaticResource Value}" Text="–"/>
                                        <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Länge"/>
                                        <TextBlock x:Name="LonText" Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" Text="–"/>
                                        <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="UTM Ost"/>
                                        <TextBlock x:Name="EastText" Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}" Text="–"/>
                                        <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="UTM Nord"/>
                                        <TextBlock x:Name="NorthText" Grid.Row="3" Grid.Column="1" Style="{StaticResource Value}" Text="–"/>
                                        <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Höhe ellips."/>
                                        <TextBlock x:Name="HEllText" Grid.Row="4" Grid.Column="1" Style="{StaticResource Value}" Text="–"/>
                                        <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="Höhe (MSL)"/>
                                        <TextBlock x:Name="HMslText" Grid.Row="5" Grid.Column="1" Style="{StaticResource Value}" Text="–"/>
                                        <TextBlock Grid.Row="6" Style="{StaticResource Label}" Text="Sat. / HDOP"/>
                                        <TextBlock x:Name="SatText" Grid.Row="6" Grid.Column="1" Style="{StaticResource Value}" Text="–"/>
                                        <TextBlock Grid.Row="7" Style="{StaticResource Label}" Text="Genauigkeit"/>
                                        <TextBlock x:Name="AccText" Grid.Row="7" Grid.Column="1" Style="{StaticResource Value}" Text="–"/>
                                    </Grid>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ============ Punkte ============ -->
                    <TabItem Header="Punkte">
                        <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <GroupBox Header="Grenzpunkt anlegen">
                                <StackPanel>
                                    <WrapPanel>
                                        <ToggleButton x:Name="AddPointToggle" Content="＋ In Karte setzen" Click="AddPointToggle_Click"
                                                      ToolTip="Aktiviert: jeder Klick in die Karte legt einen Grenzpunkt an."/>
                                        <Button Content="＋ Manuell (Koordinaten eingeben)" Click="NewPoint_Click"
                                                ToolTip="Legt einen Punkt an der aktuellen Position/Kartenmitte an, den Sie in der Tabelle bearbeiten."/>
                                    </WrapPanel>
                                    <Separator Margin="0,4"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="Position mit dem Empfänger erfassen (Mittelung über mehrere Epochen):"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Label}" Text="Name"/>
                                        <TextBox x:Name="PointNameBox" Width="90" Text="GP1"/>
                                        <TextBlock Style="{StaticResource Label}" Text="Epochen" Margin="12,3,8,3"/>
                                        <TextBox x:Name="EpochsBox" Width="45" Text="30"/>
                                        <CheckBox x:Name="OnlyFixedBox" Content="nur RTK Fixed" IsChecked="True" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="CaptureButton" Content="◉ Aktuelle Position erfassen" FontWeight="SemiBold" Click="Capture_Click"/>
                                    <Grid Margin="0,2,0,0">
                                        <ProgressBar x:Name="CaptureProgress" Height="16" Minimum="0" Maximum="1"/>
                                        <TextBlock x:Name="CaptureText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <TextBlock Grid.Row="1" Style="{StaticResource Hint}"
                                       Text="Tipp: Name, Koordinaten, Höhe und Bemerkung direkt in der Tabelle ändern (Doppelklick). Ost/Nord sind UTM-Werte (ETRS89)."/>

                            <DataGrid x:Name="PointsGrid" Grid.Row="2" SelectionChanged="PointsGrid_SelectionChanged" CellEditEnding="PointsGrid_CellEditEnding">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="70"/>
                                    <DataGridTextColumn Header="Ost [m]" Binding="{Binding Easting, StringFormat=F3}" Width="85"/>
                                    <DataGridTextColumn Header="Nord [m]" Binding="{Binding Northing, StringFormat=F3}" Width="95"/>
                                    <DataGridTextColumn Header="Breite [°]" Binding="{Binding Latitude, StringFormat=F9}" Width="100"/>
                                    <DataGridTextColumn Header="Länge [°]" Binding="{Binding Longitude, StringFormat=F9}" Width="100"/>
                                    <DataGridTextColumn Header="h ell. [m]" Binding="{Binding Height, StringFormat=F3, TargetNullValue=''}" Width="75"/>
                                    <DataGridTextColumn Header="Bemerkung" Binding="{Binding Note}" Width="120"/>
                                    <DataGridTextColumn Header="Quelle" Binding="{Binding Source}" IsReadOnly="True" Width="60"/>
                                    <DataGridTextColumn Header="Qualität" Binding="{Binding Quality}" IsReadOnly="True" Width="80"/>
                                    <DataGridTextColumn Header="σ Lage [mm]" Binding="{Binding StdEast, StringFormat=F1}" IsReadOnly="True" Width="75"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <WrapPanel Grid.Row="3" Margin="0,6,0,0">
                                <Button Content="⌖ Zeigen" Click="PointZoom_Click" ToolTip="Zoomt in der Karte auf den Punkt"/>
                                <Button Content="↻ Neu messen" Click="PointRemeasure_Click" ToolTip="Ersetzt die Koordinaten des gewählten Punktes durch eine neue GNSS-Messung"/>
                                <Button Content="➤ Navigieren" Click="PointNavigate_Click" ToolTip="Zum gewählten Punkt navigieren (Absteckung)"/>
                                <Button Content="✕ Löschen" Click="PointDelete_Click"/>
                            </WrapPanel>
                        </Grid>
                    </TabItem>

                    <!-- ============ Navigation ============ -->
                    <TabItem Header="Navigation">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                            <StackPanel>
                                <GroupBox Header="Ziel wählen">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Content="◀" Click="NavPrev_Click" Margin="0,3,6,3"/>
                                            <ComboBox x:Name="NavTargetBox" Grid.Column="1" DisplayMemberPath="Name" SelectionChanged="NavTarget_SelectionChanged"/>
                                            <Button Grid.Column="2" Content="▶" Click="NavNext_Click" Margin="6,3,0,3"/>
                                        </Grid>
                                        <ToggleButton x:Name="NavToggle" Content="Navigation starten" Click="NavToggle_Click" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </GroupBox>

                                <Border Background="{StaticResource Panel}" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid Height="200" Width="200">
                                            <Ellipse Stroke="#ADB5BD" StrokeThickness="2" Fill="White"/>
                                            <Canvas x:Name="NavNorthRing" Width="200" Height="200">
                                                <Canvas.RenderTransform><RotateTransform x:Name="NavNorthRotate" CenterX="100" CenterY="100"/></Canvas.RenderTransform>
                                                <TextBlock Text="N" Canvas.Left="91" Canvas.Top="4" FontWeight="Bold" Foreground="#E03131" FontSize="15"/>
                                                <TextBlock Text="S" Canvas.Left="92" Canvas.Top="176" Foreground="#868E96"/>
                                                <TextBlock Text="O" Canvas.Left="184" Canvas.Top="90" Foreground="#868E96"/>
                                                <TextBlock Text="W" Canvas.Left="6" Canvas.Top="90" Foreground="#868E96"/>
                                            </Canvas>
                                            <Canvas Width="200" Height="200">
                                                <Canvas.RenderTransform><RotateTransform x:Name="NavArrowRotate" CenterX="100" CenterY="100"/></Canvas.RenderTransform>
                                                <Polygon x:Name="NavArrow" Fill="#1C7ED6" Stroke="White" StrokeThickness="2" Points="100,28 132,122 100,106 68,122"/>
                                            </Canvas>
                                        </Grid>
                                        <TextBlock x:Name="NavDistText" Style="{StaticResource BigNumber}" Text="–" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="NavBearingText" HorizontalAlignment="Center" Foreground="#495057" Text="Kein Ziel"/>
                                        <Border x:Name="NavStatusBorder" CornerRadius="4" Padding="8,3" Margin="0,8,0,0" Background="#DEE2E6" HorizontalAlignment="Center">
                                            <TextBlock x:Name="NavStatusText" Text="Navigation nicht aktiv" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <GroupBox Header="Absteckung">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource Label}" Text="vor / zurück"/>
                                        <TextBlock x:Name="NavForwardText" Grid.Column="1" Style="{StaticResource Value}" Text="–"/>
                                        <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="links / rechts"/>
                                        <TextBlock x:Name="NavRightText" Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" Text="–"/>
                                        <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Δ Ost"/>
                                        <TextBlock x:Name="NavDEText" Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}" Text="–"/>
                                        <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Δ Nord"/>
                                        <TextBlock x:Name="NavDNText" Grid.Row="3" Grid.Column="1" Style="{StaticResource Value}" Text="–"/>
                                        <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Δ Höhe"/>
                                        <TextBlock x:Name="NavDHText" Grid.Row="4" Grid.Column="1" Style="{StaticResource Value}" Text="–"/>
                                    </Grid>
                                </GroupBox>

                                <GroupBox Header="Einstellungen">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="NavHeadingUp" Content="Pfeil nach Fahrtrichtung" IsChecked="True" Margin="0,0,14,0"/>
                                            <RadioButton x:Name="NavNorthUp" Content="Pfeil nach Norden"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Style="{StaticResource Label}" Text="Toleranz „erreicht“ [m]"/>
                                            <TextBox x:Name="NavToleranceBox" Width="60" Text="0,03"/>
                                        </StackPanel>
                                        <TextBlock x:Name="NavHeadingInfo" Style="{StaticResource Hint}"
                                                   Text="Die Fahrtrichtung kommt vom Empfänger (RMC) und steht erst ab ca. 0,5 m/s Bewegung zur Verfügung. Im Stand bleibt die letzte Richtung erhalten."/>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ============ Spuren ============ -->
                    <TabItem Header="Spuren">
                        <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <GroupBox Header="Aufnahme">
                                <StackPanel>
                                    <WrapPanel>
                                        <Button x:Name="RecordButton" Content="● Aufnahme starten" Click="Record_Click" FontWeight="SemiBold" Foreground="#C92A2A"/>
                                        <Button x:Name="PauseButton" Content="❚❚ Pause" Click="Pause_Click" IsEnabled="False"/>
                                        <Button x:Name="StopButton" Content="■ Beenden" Click="Stop_Click" IsEnabled="False"/>
                                    </WrapPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Label}" Text="Punkt alle"/>
                                        <TextBox x:Name="MinDistBox" Width="45" Text="0,5"/>
                                        <TextBlock Style="{StaticResource Label}" Text="m bei"/>
                                        <ComboBox x:Name="TrackQualityBox" Width="150" SelectedIndex="1">
                                            <ComboBoxItem Content="jedem gültigen Fix"/>
                                            <ComboBoxItem Content="nur RTK (Float/Fixed)"/>
                                            <ComboBoxItem Content="nur RTK Fixed"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <TextBlock x:Name="LiveStatsText" Style="{StaticResource Hint}" Text="Keine Aufnahme aktiv."/>
                                </StackPanel>
                            </GroupBox>

                            <DataGrid x:Name="TracksGrid" Grid.Row="1" SelectionChanged="TracksGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Start" Binding="{Binding Start, StringFormat='dd.MM. HH:mm'}" IsReadOnly="True" Width="85"/>
                                    <DataGridTextColumn Header="Dauer" Binding="{Binding DurationText}" IsReadOnly="True" Width="60"/>
                                    <DataGridTextColumn Header="Länge [m]" Binding="{Binding LengthM, StringFormat=F1}" IsReadOnly="True" Width="75"/>
                                    <DataGridTextColumn Header="Punkte" Binding="{Binding Count}" IsReadOnly="True" Width="55"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <WrapPanel Grid.Row="2" Margin="0,6,0,0">
                                <Button Content="⌖ Zeigen" Click="TrackZoom_Click"/>
                                <Button Content="✕ Löschen" Click="TrackDelete_Click"/>
                                <Button Content="Importieren…" Click="MenuImport_Click" ToolTip="GPX-Datei laden"/>
                                <Button Content="Export GPX…" Click="MenuExportGpx_Click"/>
                            </WrapPanel>

                            <GroupBox Grid.Row="3" Header="Wiedergabe der gewählten Spur" Margin="0,6,0,0">
                                <StackPanel>
                                    <Slider x:Name="ReplaySlider" Minimum="0" Maximum="1" ValueChanged="ReplaySlider_ValueChanged" IsEnabled="False"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="ReplayPlayButton" Content="▶ Abspielen" Click="ReplayPlay_Click" IsEnabled="False"/>
                                        <ComboBox x:Name="ReplaySpeedBox" Width="70" SelectedIndex="1">
                                            <ComboBoxItem Content="1×" Tag="1"/><ComboBoxItem Content="5×" Tag="5"/><ComboBoxItem Content="20×" Tag="20"/>
                                        </ComboBox>
                                        <TextBlock x:Name="ReplayText" Style="{StaticResource Label}" Margin="10,3,0,3"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                        </Grid>
                    </TabItem>

                    <!-- ============ Messen ============ -->
                    <TabItem Header="Messen">
                        <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="80"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="70"/>
                            </Grid.RowDefinitions>

                            <GroupBox Header="1  Messart">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="MeasureStrecke" Content="Strecke / Distanz" IsChecked="True" Margin="0,0,14,0" Checked="MeasureKind_Checked"/>
                                    <RadioButton x:Name="MeasureFlaeche" Content="Fläche" Margin="0,0,14,0" Checked="MeasureKind_Checked"/>
                                    <RadioButton x:Name="MeasureHoehe" Content="Höhe / Höhenunterschied" Checked="MeasureKind_Checked"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Grid.Row="1" Header="2  Messpunkte hinzufügen">
                                <StackPanel>
                                    <WrapPanel>
                                        <ToggleButton x:Name="MeasureMapToggle" Content="＋ In Karte klicken" Click="MeasureMapToggle_Click"/>
                                        <Button Content="＋ Aktuelle Position" Click="MeasureAddCurrent_Click" ToolTip="Fügt die momentane GNSS-Position (mit Höhe) hinzu"/>
                                        <Button Content="＋ Gewählter Grenzpunkt" Click="MeasureAddPoint_Click"/>
                                        <Button Content="＋ Alle Grenzpunkte" Click="MeasureAddAllPoints_Click"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="MeasureHint" Style="{StaticResource Hint}"/>
                                </StackPanel>
                            </GroupBox>

                            <DataGrid x:Name="VertexGrid" Grid.Row="2" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="30"/>
                                    <DataGridTextColumn Header="Quelle" Binding="{Binding Source}" Width="80"/>
                                    <DataGridTextColumn Header="Breite [°]" Binding="{Binding Lat, StringFormat=F8}" Width="95"/>
                                    <DataGridTextColumn Header="Länge [°]" Binding="{Binding Lon, StringFormat=F8}" Width="95"/>
                                    <DataGridTextColumn Header="h ell. [m]" Binding="{Binding H, StringFormat=F3, TargetNullValue='–'}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <GroupBox Grid.Row="3" Header="3  Ergebnis" Margin="0,6,0,6">
                                <StackPanel>
                                    <TextBlock x:Name="MeasureResultText" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" Text="Noch keine Messpunkte."/>
                                    <WrapPanel Margin="0,6,0,0">
                                        <Button Content="↶ Letzten entfernen" Click="MeasureUndo_Click"/>
                                        <Button Content="Neu beginnen" Click="MeasureClear_Click"/>
                                    </WrapPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="MeasureNameBox" Width="150" ToolTip="Name der Messung (optional)"/>
                                        <Button Content="💾 Messung speichern" Click="MeasureSave_Click" Margin="6,3,6,3" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <Grid Grid.Row="4">
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <DataGrid x:Name="MeasurementsGrid" SelectionChanged="MeasurementsGrid_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Gespeicherte Messung" Binding="{Binding Name}" Width="140"/>
                                        <DataGridTextColumn Header="Art" Binding="{Binding KindText}" IsReadOnly="True" Width="60"/>
                                        <DataGridTextColumn Header="Ergebnis" Binding="{Binding Summary}" IsReadOnly="True" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Button Grid.Row="1" Content="✕ Messung löschen" Click="MeasurementDelete_Click" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>

            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Ausgabe -->
            <TabControl x:Name="OutputTabs" Grid.Row="2">
                <TabItem Header="SAPOS-Daten (RTCM)">
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="400"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
                            <TextBlock x:Name="RtcmStationText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Text="Noch keine Korrekturdaten empfangen."/>
                        </ScrollViewer>
                        <DataGrid x:Name="RtcmGrid" Grid.Column="1" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Typ" Binding="{Binding Type}" Width="50"/>
                                <DataGridTextColumn Header="Bedeutung" Binding="{Binding Name}" Width="260"/>
                                <DataGridTextColumn Header="Anzahl" Binding="{Binding Count}" Width="60"/>
                                <DataGridTextColumn Header="Rate" Binding="{Binding Rate}" Width="65"/>
                                <DataGridTextColumn Header="Zuletzt" Binding="{Binding Last}" Width="70"/>
                                <DataGridTextColumn Header="Inhalt" Binding="{Binding Info}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
                <TabItem Header="Empfänger (NMEA)">
                    <DockPanel Margin="4">
                        <CheckBox x:Name="NmeaPauseBox" DockPanel.Dock="Top" Content="Anzeige anhalten" Margin="0,0,0,4"/>
                        <TextBox x:Name="NmeaBox" IsReadOnly="True" FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0"/>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Protokoll">
                    <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="4"/>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
